# ============================================================
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env or .env.local to version control!
# ============================================================

APP_ENV=dev
APP_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING

# PostgreSQL (Docker setup)
DATABASE_URL="postgresql://symfony:symfony@db:5432/woofie?serverVersion=15&charset=utf8"
# SQLite (lightweight local dev — no Docker needed)
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# JWT authentication — generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Ollama local AI engine
OLLAMA_API_URL=http://ollama:11434

# Messenger
MESSENGER_TRANSPORT_DSN=sync://

# INSEE Sirene API (optional — SIRET online validation)
# INSEE_API_KEY=YOUR_INSEE_BEARER_TOKEN

# App base URL
DEFAULT_URI=http://localhost:8000/
