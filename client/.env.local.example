# Copy to .env.local for local Next.js development.

# Browser API calls. Empty keeps same-origin /api requests when a reverse proxy is used.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side Next.js API routes, for example /api/pois.
INTERNAL_API_BASE=http://localhost:8000

# WebSocket stays disabled unless the backend websocket service is deployed.
NEXT_PUBLIC_WS_ENABLED=false
