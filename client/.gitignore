# ============================================================
# Client .gitignore — Next.js 15 frontend
# ============================================================

# ---- Dependencies (restored via `npm install`) ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Test coverage ----
/coverage

# ---- Next.js build output ----
/.next/
/out/
/build

# ---- Environment & secrets (NEVER commit) ----
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ---- Debug logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Vercel ----
.vercel

# ---- TypeScript generated ----
*.tsbuildinfo
next-env.d.ts

# ---- macOS ----
.DS_Store
*.pem
