events {}

http {
    server {
        listen 80;
        server_name ${APP_DOMAIN} www.${APP_DOMAIN};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 200 "Woofie — initialisation SSL en cours, revenez dans 1 minute...";
            add_header Content-Type text/plain;
        }
    }
}
