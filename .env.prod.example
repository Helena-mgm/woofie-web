# ============================================================
# 🐾 Woofie — Variables d'environnement PRODUCTION
# ============================================================
# 1. Copiez ce fichier sur le VPS :
#      cp .env.prod.example .env.prod
# 2. Remplissez toutes les valeurs marquées CHANGEZ_MOI
# 3. Ne committez JAMAIS .env.prod dans git !
# ============================================================

# ── Base de données PostgreSQL ─────────────────────────────
POSTGRES_USER=woofie
POSTGRES_DB=woofie
# Générez un mot de passe fort, ex: openssl rand -hex 20
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_FORT

# ── Symfony ────────────────────────────────────────────────
APP_DOMAIN=woofie.ovh
APP_URL=https://woofie.ovh
# Clé secrète app (32 hex) — générez avec : openssl rand -hex 32
APP_SECRET=CHANGEZ_CETTE_VALEUR_32_CARACTERES_HEX

# ── JWT Authentication ─────────────────────────────────────
# Secret JWT (base64) — générez avec : openssl rand -base64 64
JWT_SECRET=CHANGEZ_CE_SECRET_JWT_TRES_LONG_EN_BASE64==
JWT_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=1

# ── Sécurité HTTP/API ──────────────────────────────────────
# Origines autorisées séparées par des virgules ; pas de wildcard en prod.
CORS_ALLOW_ORIGIN=https://woofie.ovh,https://www.woofie.ovh
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PIXELS=20000000
NGINX_UPLOAD_MAX_SIZE=5m

# ── Services internes ──────────────────────────────────────
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RESPONSE_CHARS=10000
INTERNAL_API_BASE=http://nginx

# Facultatif : active la vérification SIRET en ligne auprès de l'INSEE.
INSEE_API_KEY=

# ── Let's Encrypt ──────────────────────────────────────────
# Email utilisé pour les notifications d'expiration de cert
CERTBOT_EMAIL=admin@woofie.ovh
